{
  "name": "exam-webcam-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup-models": "node scripts/download-models.mjs",
    "postinstall": "node scripts/download-models.mjs || true",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "desktop:dist": "vite build && electron-builder --win portable"
  },
  "dependencies": {
    "@vladmandic/face-api": "^1.7.14",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "description": "Exam candidate photo capture (web + desktop)",
  "author": "Exam Centre",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.examcentre.photocapture",
    "productName": "ExamPhotoCapture",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    }
  }
}
